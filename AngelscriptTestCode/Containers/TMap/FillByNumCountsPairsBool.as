/**
 * @begin FillByNumCountsPairsBool
 * @summary An &out TMap<int, bool> is filled so Num becomes 3.
 * @topic Containers
 */
void FillByNumCountsPairsBool(TMap<int, bool>&out Result)
{
	Result.Add(1, true);
	Result.Add(2, false);
	Result.Add(3, true);
}
/** @end */
