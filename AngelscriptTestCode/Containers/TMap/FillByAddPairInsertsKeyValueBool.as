/**
 * @begin FillByAddPairInsertsKeyValueBool
 * @summary An &out TMap<int, bool> is filled by Add of three pairs.
 * @topic Containers
 */
void FillByAddPairInsertsKeyValueBool(TMap<int, bool>&out Result)
{
	Result.Add(1, true);
	Result.Add(2, false);
	Result.Add(3, true);
}
