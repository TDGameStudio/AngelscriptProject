/**
 * @begin NumCountsPairsIn
 * @summary Num on a const TMap<int,int>&in reports the live pair count without writing the map back.
 * @topic Containers
 */
bool NumCountsPairsIn(const TMap<int, int>&in Values)
{
	return Values.Num() == 3;
}
