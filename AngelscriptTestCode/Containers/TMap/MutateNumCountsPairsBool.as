/**
 * @begin MutateNumCountsPairsBool
 * @summary An &inout TMap<int, bool> Adds one pair so Num becomes 3.
 * @topic Containers
 */
void MutateNumCountsPairsBool(TMap<int, bool>&inout Values)
{
	Values.Add(3, true);
}
/** @end */
