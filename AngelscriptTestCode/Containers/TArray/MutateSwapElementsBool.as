/**
 * @begin MutateSwapElementsBool
 * @summary An &inout TArray<bool> receives Swap of the end indices.
 * @topic Containers
 */
void MutateSwapElementsBool(TArray<bool>&inout Values)
{
	Values.Swap(0, 2);
}
/** @end */
