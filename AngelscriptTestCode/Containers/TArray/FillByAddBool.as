/**
 * @begin FillByAddBool
 * @summary An &out TArray<bool> is filled by Add in insertion order.
 * @topic Containers
 */
void FillByAddBool(TArray<bool>&out Result)
{
	Result.Add(false);
	Result.Add(true);
	Result.Add(false);
}
/** @end */
