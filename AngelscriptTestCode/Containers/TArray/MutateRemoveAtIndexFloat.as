/**
 * @begin MutateRemoveAtIndexFloat
 * @summary An &inout TArray<float> has its first index deleted by RemoveAt.
 * @topic Containers
 */
void MutateRemoveAtIndexFloat(TArray<float>&inout Values)
{
	Values.RemoveAt(0);
}
/** @end */
