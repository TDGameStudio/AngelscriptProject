/**
 * @begin ReadNumCountsElements
 * @summary A const&in TArray<int32> reports Num of three elements.
 * @topic Containers
 */
bool ReadNumCountsElements(const TArray<int32>&in Values)
{
	return Values.Num() == 3;
}
