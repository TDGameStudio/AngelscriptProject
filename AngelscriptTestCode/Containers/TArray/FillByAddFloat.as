/**
 * @begin FillByAddFloat
 * @summary An &out TArray<float> is filled by Add in insertion order.
 * @topic Containers
 */
void FillByAddFloat(TArray<float>&out Result)
{
	Result.Add(10.0f);
	Result.Add(20.0f);
	Result.Add(30.0f);
}
/** @end */
