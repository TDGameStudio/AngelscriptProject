/**
 * @begin FillByAdd
 * @summary An &out TArray<int32> is filled by Add in insertion order.
 * @topic Containers
 */
void FillByAdd(TArray<int32>&out Result)
{
	Result.Add(10);
	Result.Add(20);
	Result.Add(30);
}
