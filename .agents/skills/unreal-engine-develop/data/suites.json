{
  "schemaVersion": "hardness-unreal-suites-v1",
  "launchProfile": "headless",
  "description": "Tracked Unreal Automation-only suites for the AngelscriptProject host.",
  "deferredCapabilities": [
    {
      "id": "Standalone",
      "status": "Deferred",
      "kind": "CMakeCTest",
      "reason": "Standalone CMake and CTest execution is outside the Unreal Automation runner."
    },
    {
      "id": "StandaloneRelease",
      "status": "Deferred",
      "kind": "CMakeCTestRelease",
      "reason": "Release CTest and ZIP validation require a separate release pipeline."
    },
    {
      "id": "CachePackage",
      "status": "Deferred",
      "kind": "PackageSmoke",
      "reason": "Cache package smoke mutates packaged outputs and is outside this Change."
    },
    {
      "id": "package",
      "status": "Deferred",
      "kind": "Pipeline",
      "reason": "Packaging is not an Unreal Automation suite entry."
    },
    {
      "id": "coverage",
      "status": "Deferred",
      "kind": "Pipeline",
      "reason": "Coverage collection requires its own orchestration and evidence contract."
    },
    {
      "id": "release",
      "status": "Deferred",
      "kind": "Pipeline",
      "reason": "Release validation and publication require explicit release authority."
    }
  ],
