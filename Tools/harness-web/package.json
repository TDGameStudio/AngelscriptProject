{
  "name": "harness-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "start": "node dist/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test:adapter": "vitest run tests/adapter",
    "test:documents": "vitest run tests/documents",
    "test:ui": "vitest run tests/ui",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "format:check": "prettier --check src tests *.ts *.json index.html README.md",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@fastify/middie": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@milkdown/crepe": "^7.15.5",
    "@milkdown/kit": "^7.15.5",
    "@milkdown/react": "^7.15.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@xyflow/react": "^12.8.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "fastify": "^5.6.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.12.0",
    "minisearch": "^7.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.52",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
