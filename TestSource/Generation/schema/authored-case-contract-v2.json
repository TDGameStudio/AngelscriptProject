{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authored-case-contract-v2",
  "title": "TestSource authored case contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "sourcePath",
    "namespace",
    "sourceShape",
    "executionProfile",
    "legacySymbols",
    "functions",
    "coverage",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": "authored-case-contract-v2" },
    "caseId": { "type": "string", "minLength": 1, "pattern": "^TS-[A-Z0-9-]+$" },
    "subcaseId": { "$ref": "#/$defs/subcaseId" },
    "sourcePath": {
      "type": "string",
      "pattern": "^TestSource/(?!Generation/).+\\.as$"
    },
    "namespace": { "type": "string" },
    "sourceShape": {
      "enum": [
        "GlobalFunctions",
        "NamespaceFunctions",
        "ClassMethods",
        "StructMethods",
        "InterfaceMethods",
        "Delegates",
        "Mixed",
        "CompileDiagnostic"
      ]
    },
    "executionProfile": { "$ref": "#/$defs/executionProfile" },
    "legacySymbols": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "review": { "$ref": "#/$defs/review" }
  },
  "$defs": {
    "subcaseId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "isolation"],
      "properties": {
        "mode": { "enum": ["Runtime", "CompileOnly", "DiagnosticOnly", "Framework"] },
        "isolation": {
          "enum": ["DefaultSafe", "FixtureIsolated", "Exclusive", "SubprocessOnly"]
        },
        "requiredHarness": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "owner"],
      "properties": {
        "kind": {
          "enum": [
            "None",
            "Value",
            "Object",
            "ClassDefaultObject",
            "Actor",
            "Component",
            "World",
            "GameInstance",
            "External",
            "Compiler"
          ]
        },
        "identity": { "type": "string" },
        "owner": { "type": "string" },
        "class": { "type": "string" },
        "outer": { "type": "string" },
        "flags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "setup": { "type": "string" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "asType", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "asType": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["value", "in", "out", "inout"] },
        "preCall": { "$ref": "#/$defs/typedValue" },
        "expectedPostCall": { "$ref": "#/$defs/typedValue" },
        "default": { "type": "string" }
      }
    },
    "returnContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asType"],
      "properties": {
        "asType": { "type": "string", "minLength": 1 },
        "hostVisibleState": { "type": "string", "minLength": 1 }
      }
    },
    "writeback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter"],
      "properties": {
        "parameter": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asType"],
      "properties": {
        "asType": { "type": "string", "minLength": 1 },
        "value": {},
        "isNull": { "type": "boolean" },
        "identity": { "type": "string" },
        "class": { "type": "string" },
        "outer": { "type": "string" },
        "name": { "type": "string" },
        "flags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "ordering": { "enum": ["ordered", "unordered"] },
        "elements": {
          "type": "array",
          "items": {}
        },
        "allowDuplicates": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["value"] },
        { "required": ["isNull"] },
        { "required": ["identity"] },
        { "required": ["class"] },
        { "required": ["outer"] },
        { "required": ["name"] },
        { "required": ["flags"] },
        { "required": ["elements", "ordering"] }
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asType", "comparison"],
      "properties": {
        "asType": { "type": "string", "minLength": 1 },
        "comparison": {
          "enum": [
            "exact",
            "near",
            "sameIdentity",
            "differentIdentity",
            "orderedElements",
            "unorderedElements",
            "contains",
            "atLeast",
            "relation",
            "exception",
            "compileDiagnostic"
          ]
        },
        "value": {},
        "isNull": { "type": "boolean" },
        "identity": { "type": "string" },
        "class": { "type": "string" },
        "outer": { "type": "string" },
        "name": { "type": "string" },
        "flags": { "type": "array", "items": { "type": "string" } },
        "elements": { "type": "array", "items": {} },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "relation": { "type": "string", "minLength": 1 }
      }
    },
    "vectorWriteback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "before", "after", "comparison"],
      "properties": {
        "parameter": { "type": "string", "minLength": 1 },
        "before": { "$ref": "#/$defs/typedValue" },
        "after": { "$ref": "#/$defs/typedValue" },
        "comparison": { "$ref": "#/$defs/comparison" },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "relation": { "type": "string", "minLength": 1 }
      }
    },
    "comparison": {
      "enum": [
        "exact",
        "near",
        "sameIdentity",
        "differentIdentity",
        "orderedElements",
        "unorderedElements",
        "contains",
        "atLeast",
        "relation",
        "exception",
        "compileDiagnostic"
      ]
    },
    "diagnosticOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "message"],
      "properties": {
        "comparison": { "enum": ["exception", "compileDiagnostic"] },
        "type": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arguments", "writebacks"],
      "properties": {
        "id": { "$ref": "#/$defs/subcaseId" },
        "arguments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/typedValue" }
        },
        "expectedReturn": { "$ref": "#/$defs/oracle" },
        "writebacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/vectorWriteback" }
        },
        "expectedException": { "$ref": "#/$defs/diagnosticOracle" },
        "expectedCompileDiagnostic": { "$ref": "#/$defs/diagnosticOracle" }
      }
    },
    "commentFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "inputs", "outputs", "boundary", "cleanup"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "inputs": { "type": "string", "minLength": 1 },
        "outputs": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "cleanup": { "type": "string", "minLength": 1 }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subcaseId",
        "owner",
        "role",
        "name",
        "declaration",
        "annotations",
        "legacyDeclaration",
        "requiredNameReason",
        "zeroArgumentReason",
        "fixture",
        "phase",
        "cleanupOwner",
        "parameters",
        "return",
        "writebacks",
        "vectors",
        "commentFacts"
      ],
      "properties": {
        "subcaseId": { "$ref": "#/$defs/subcaseId" },
        "owner": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "Entry",
            "Helper",
            "Constructor",
            "Destructor",
            "Operator",
            "Delegate",
            "Event",
            "Import",
            "Mixin",
            "Lambda",
            "LifecycleCallback",
            "FrameworkHook",
            "NegativeTrigger"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "declaration": { "type": "string", "minLength": 1 },
        "annotations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "legacyDeclaration": { "type": "string" },
        "requiredNameReason": { "type": "string" },
        "zeroArgumentReason": { "type": "string" },
        "fixture": { "$ref": "#/$defs/fixture" },
        "phase": {
          "enum": [
            "Arrange",
            "Act",
            "Read",
            "Release",
            "Cleanup",
            "Compile",
            "Framework"
          ]
        },
        "cleanupOwner": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "return": { "$ref": "#/$defs/returnContract" },
        "writebacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/writeback" }
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vector" }
        },
        "commentFacts": { "$ref": "#/$defs/commentFacts" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "command", "result"],
      "properties": {
        "stage": {
          "enum": ["source-strict", "compile", "runtime", "external-oracle"]
        },
        "command": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "blocked"] },
        "recordedAt": { "type": "string", "format": "date" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": [
            "designed",
            "reviewed",
            "strict-pass",
            "compile-verified",
            "runtime-verified",
            "external-oracle-verified",
            "runner-blocked",
            "audit-only"
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewer", "reviewedAt"],
      "properties": {
        "state": { "enum": ["draft", "reviewed", "legacy-unreviewed"] },
        "reviewer": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
