{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-result-v1",
  "title": "Angelscript generation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "origin",
    "caseKey",
    "recipeId",
    "recipeVersion",
    "seed",
    "selectedAxes",
    "sourceBundle",
    "manifestUtf8",
    "cells",
    "oracle",
    "commentFacts",
    "references",
    "harness",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "generation-result-v1"
    },
    "origin": { "type": "string" },
    "caseKey": { "type": "string" },
    "recipeId": { "type": "string" },
    "recipeVersion": { "type": "string" },
    "seed": { "type": "string" },
    "selectedAxes": {
      "type": "object",
      "additionalProperties": true
    },
    "sourceBundle": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logicalPath", "utf8BytesHex"],
        "properties": {
          "logicalPath": { "type": "string" },
          "utf8BytesHex": {
            "type": "string",
            "description": "Canonical UTF-8 source bytes as lowercase hex."
          },
          "role": { "type": "string" }
        }
      }
    },
    "manifestUtf8": {
      "type": "string",
      "description": "Canonical JSON manifest bytes as UTF-8 text (LF, no BOM, one trailing newline)."
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cellIndex", "declaration", "entryPoint"],
        "properties": {
          "cellIndex": { "type": "integer", "minimum": 0 },
          "declaration": { "type": "string" },
          "entryPoint": { "type": "string" },
          "arguments": { "type": "array" },
          "axisValues": { "type": "object" }
        }
      }
    },
    "oracle": { "$ref": "#/$defs/oracle" },
    "commentFacts": { "$ref": "#/$defs/commentFacts" },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "harness": {
      "type": "array",
      "items": { "type": "string" }
    },
    "negativeMutation": {
      "type": ["object", "null"]
    },
    "recoverySourceHex": {
      "type": ["string", "null"]
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "$defs": {
    "oracle": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "compileStatus": { "type": "string" },
        "comparison": { "type": "string" },
        "payload": { "type": "object" }
      }
    },
    "commentFacts": {
      "type": "object",
      "properties": {
        "feature": { "type": "string" },
        "inputs": { "type": "string" },
        "expectations": { "type": "string" },
        "boundary": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
