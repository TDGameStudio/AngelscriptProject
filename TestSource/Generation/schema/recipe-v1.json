{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe-v1",
  "title": "Angelscript generation recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipeId",
    "recipeVersion",
    "owner",
    "explicitAxes",
    "constraints",
    "randomSlots",
    "oracleKinds",
    "negativePolicy",
    "commentPolicy"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "recipe-v1" },
    "recipeId": { "type": "string" },
    "recipeVersion": { "type": "string" },
    "owner": { "type": "string" },
    "explicitAxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "properties": {
          "name": { "type": "string" },
          "values": { "type": "array" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "object" }
    },
    "randomSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "oracleKinds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "negativePolicy": { "type": "string" },
    "commentPolicy": { "type": "string" },
    "emits": { "type": "string" },
    "mandatoryCellCount": { "type": "integer", "minimum": 0 }
  }
}
