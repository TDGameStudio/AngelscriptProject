{
  "schemaVersion": "recipe-v1",
  "recipeId": "function-signature-product",
  "recipeVersion": "1",
  "owner": "TestSource/Generation/Rules/NativeSDK",
  "explicitAxes": [
    {
      "name": "Direction",
      "values": ["In", "Out", "InOut", "Return"]
    },
    {
      "name": "Type",
      "values": [
        "void",
        "bool",
        "int8",
        "int16",
        "int32",
        "int64",
        "uint8",
        "uint16",
        "uint32",
        "uint64",
        "float",
        "double",
        "string",
        "handle",
        "value"
      ]
    }
  ],
  "constraints": [],
  "randomSlots": [
    { "name": "literal", "kind": "legal-literal" },
    { "name": "identifier", "kind": "identifier" },
    { "name": "declaration-order", "kind": "independent-order" },
    { "name": "grouping", "kind": "legal-grouping" }
  ],
  "oracleKinds": ["compile", "int", "writeback", "metadata", "lifecycle"],
  "negativePolicy": "one illegal signature or call mutation",
  "commentPolicy": "explain slot sentinels and expected transfer",
  "emits": "functions/calls + manifest + typed writeback oracle",
  "mandatoryCellCount": 60
}
