+  test('keeps SDK description immediately ahead of its tags and body', async ({ page }) => {
+    await page.setViewportSize({ width: 1440, height: 960 });
+    await page.goto('/#AngelscriptWikiHome');
+
+    const sdkFrame = page.locator('.tc-tiddler-frame').filter({
+      has: page.locator('.as-sdk-description'),
+    });
+    await expect(sdkFrame).toHaveCount(1);
+
+    const layout = await sdkFrame.evaluate(frame => {
+      const description = frame.querySelector('.as-sdk-description');
+      const tags = frame.querySelector('.tc-tags-wrapper');
+      const body = frame.querySelector('.tc-tiddler-body');
+      if (!description || !tags || !body) {
+        throw new Error('SDK tiddler is missing its description, tags, or body element');
+      }
+      const topLevelSibling = (element: Element) => {
+        let sibling = element;
+        while (sibling.parentElement !== frame) {
+          if (!sibling.parentElement) {
+            throw new Error('SDK tiddler element is outside its frame');
+          }
+          sibling = sibling.parentElement;
+        }
+        return sibling;
+      };
+
+      const siblings = Array.from(frame.children);
+      const descriptionBox = description.getBoundingClientRect();
+      const tagsBox = tags.getBoundingClientRect();
+      const bodyBox = body.getBoundingClientRect();
+      return {
+        bodyIndex: siblings.indexOf(topLevelSibling(body)),
+        descriptionIndex: siblings.indexOf(topLevelSibling(description)),
+        descriptionToTag: tagsBox.top - descriptionBox.bottom,
+        tagIndex: siblings.indexOf(topLevelSibling(tags)),
+        tagToBody: bodyBox.top - tagsBox.bottom,
+      };
+    });
+
+    expect(layout.descriptionIndex).toBeLessThan(layout.tagIndex);
+    expect(layout.tagIndex).toBeLessThan(layout.bodyIndex);
+    expect(layout.descriptionToTag).toBeLessThanOrEqual(12);
+    expect(layout.tagToBody).toBeGreaterThan(layout.descriptionToTag);
+  });
+
