+  test('keeps More sidebar category tabs borderless, selected, and visibly focusable', async ({ page }) => {
+    await page.setViewportSize({ width: 1440, height: 960 });
+    await page.goto('/#AS/Workflow/GettingStarted');
+
+    await page.locator('.tc-sidebar-tabs-main > .tc-tab-buttons > button').nth(3).click();
+    const categoryButtons = page.locator(
+      '.tc-more-sidebar > .tc-tab-set > .tc-tab-buttons > button',
+    );
+    await expect(categoryButtons.first()).toBeVisible();
+
+    const categoryButtonStyles = await categoryButtons.evaluateAll(buttons =>
+      buttons.map(button => getComputedStyle(button).borderRightWidth),
+    );
+    expect(categoryButtonStyles).not.toHaveLength(0);
+
+    const selectedCategory = page.locator(
+      '.tc-more-sidebar > .tc-tab-set > .tc-tab-buttons > button.tc-tab-selected',
+    );
+    await expect(selectedCategory).toBeVisible();
+
+    await selectedCategory.press('Tab');
+    const focusedCategory = page.locator(
+      '.tc-more-sidebar > .tc-tab-set > .tc-tab-buttons > button:focus',
+    );
+    await expect(focusedCategory).toBeVisible();
+    await expect(focusedCategory).toHaveCSS('outline-style', 'solid');
+    await expect(focusedCategory).toHaveCSS('outline-width', '2px');
+
+    expect(categoryButtonStyles).toEqual(categoryButtonStyles.map(() => '0px'));
+  });
